<configuration>

    <!-- KnoxIDF HA (docker-compose.knoxidf-ha.yml): two gateways, knox and knox2, share one
         PostgreSQL database. This file replaces the baked gateway-site.xml on both nodes and holds
         only what test_knoxidf_ha.py needs; everything else is left at the Knox defaults. -->
    <property>
        <name>gateway.port</name>
        <value>8443</value>
    </property>

    <!-- The knoxidf-admin topology authenticates against the embedded Knox LDAP service over
         ldaps://localhost:33390 (keystore provisioned by gateway.sh), which proxies the demo LDAP. -->
    <property>
        <name>gateway.ldap.enabled</name>
        <value>true</value>
    </property>
    <property>
        <name>gateway.ldap.port</name>
        <value>33390</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.names</name>
        <value>demoldap</value>
    </property>
    <property>
        <name>gateway.ldap.ssl.enabled</name>
        <value>true</value>
    </property>
    <property>
        <name>gateway.ldap.ssl.keystore.path</name>
        <value>/knox-runtime/conf/ldaps-keystore.p12</value>
    </property>
    <property>
        <name>gateway.ldap.ssl.keystore.password.alias</name>
        <value>gateway_ldap_ssl_keystore_password</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.interceptorType</name>
        <value>backend</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.backendType</name>
        <value>ldap</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.url</name>
        <value>ldaps://ldap:33389</value>
    </property>
    <!-- The demo LDAP presents a self-signed dev certificate. -->
    <property>
        <name>gateway.ldap.interceptor.demoldap.trustAllCertificates</name>
        <value>true</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.remoteBaseDn</name>
        <value>dc=hadoop,dc=apache,dc=org</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.systemUsername</name>
        <value>uid=guest,ou=people,dc=hadoop,dc=apache,dc=org</value>
    </property>
    <property>
        <name>gateway.ldap.interceptor.demoldap.systemPassword</name>
        <value>${ALIAS=gateway_ldap_demoldap_system_password}</value>
    </property>

    <!-- All KnoxIDF stores and token state are pinned to their JDBC implementations on the shared
         database: the embedded H2 backend rewrites gateway.database.* when it starts, so a mixed
         setup would pull the JDBC services back onto a node-local H2 database. -->
    <property>
        <name>gateway.database.type</name>
        <value>postgresql</value>
    </property>
    <property>
        <name>gateway.database.connection.url</name>
        <value>jdbc:postgresql://postgres:5432/knox?user=knox&amp;password=knox</value>
    </property>
    <property>
        <name>gateway.service.trustedoidcissuer.impl</name>
        <value>org.apache.knox.gateway.services.knoxidf.trustedoidcissuer.JdbcTrustedOidcIssuerService</value>
    </property>
    <property>
        <name>gateway.service.delegationpolicy.impl</name>
        <value>org.apache.knox.gateway.services.knoxidf.delegation.JdbcDelegationPolicyService</value>
    </property>
    <property>
        <name>gateway.service.knoxidffederatedidentity.impl</name>
        <value>org.apache.knox.gateway.services.knoxidf.federation.JdbcFederatedIdentityService</value>
    </property>
    <property>
        <name>gateway.service.tokenstate.impl</name>
        <value>org.apache.knox.gateway.services.token.impl.JDBCTokenStateService</value>
    </property>
    <!-- Short registry snapshot TTL so test_knoxidf_ha.py sees changes made on the other node
         within seconds rather than the default minute. -->
    <property>
        <name>gateway.trusted.oidc.issuer.registry.cache.ttl.secs</name>
        <value>5</value>
    </property>

</configuration>
