<!--
Same as knoxtoken.xml, but opted in to knox.token.allow.client.secret.as.access.token, so a CLIENTID
client secret presented directly as an access token is accepted (the behavior before KNOX-3601).
knoxtoken.xml keeps the default and rejects it.
-->
<topology>
	<gateway>
		<provider>
			<role>federation</role>
			<name>JWTProvider</name>
			<enabled>true</enabled>
			<param>
				<name>knox.token.use.cookie</name>
				<value>false</value>
			</param>
			<param>
				<name>jwt.expected.sigalg</name>
				<value>RS256</value>
			</param>
			<!-- Client secrets are only recognized as such when token state is server-managed. -->
			<param>
				<name>knox.token.exp.server-managed</name>
				<value>true</value>
			</param>
			<param>
				<name>knox.token.allow.client.secret.as.access.token</name>
				<value>true</value>
			</param>
		</provider>
	</gateway>
	<service>
		<role>KNOX-AUTH-SERVICE</role>
		<param>
			<name>preauth.auth.header.actor.id.name</name>
			<value>x-knox-actor-username</value>
		</param>
		<param>
			<name>preauth.auth.header.actor.groups.prefix</name>
			<value>x-knox-actor-groups</value>
		</param>
		<param>
			<name>preauth.group.filter.pattern</name>
			<value>[^\s]+</value>
		</param>
	</service>
</topology>
