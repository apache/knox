<!--
  KnoxIDF /client endpoints opted out of knoxidf.client.registration.delegated.callers.denied, so a
  delegated token may register clients and list, revoke, enable or disable the user's tokens (the
  behavior before KNOX-3600 and KNOX-3603). knoxidf-token-delegation-policy.xml keeps the default
  and refuses it. test_delegation.py presents the tokens that topology mints here.
-->
<topology>
    <gateway>
      <provider>
         <role>federation</role>
         <name>JWTProvider</name>
         <enabled>true</enabled>
         <param>
            <name>knox.token.exp.server-managed</name>
            <value>true</value>
         </param>
      </provider>
      <provider>
            <role>identity-assertion</role>
            <name>Default</name>
            <enabled>true</enabled>
      </provider>
    </gateway>

    <service>
        <role>KNOXIDF</role>
        <param>
            <name>knoxidf.knox.token.limit.per.user</name>
            <value>-1</value>
        </param>
        <param>
            <name>knoxidf.client.registration.delegated.callers.denied</name>
            <value>false</value>
        </param>
    </service>
</topology>
