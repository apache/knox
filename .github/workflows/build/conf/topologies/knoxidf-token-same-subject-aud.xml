<!--
  Same-subject requested-audience exchange topology (KNOX-3461). The JWTProvider
  turns on delegation.same.subject.requested.audience.enabled, which authorizes a
  requested audience on a same-subject exchange against the subject token's own
  aud claim: a requested value the subject token already carries is honored (and
  minted onto the exchanged token), a value it does not carry is rejected with
  invalid_target.

  The KNOXIDF service uses the 'passthrough' audience validator so an authorized
  requested audience is actually minted onto the exchanged token. Enabling the
  flag is precisely what makes a passthrough validator safe here: without it a
  same-subject exchange could otherwise mint an arbitrarily-audienced token. This
  topology does NOT enable delegation.server.enabled; the flag is orthogonal to
  delegation, so an actor_token exchange here is still rejected outright.
-->
<topology>
    <gateway>
      <provider>
         <role>federation</role>
         <name>JWTProvider</name>
         <enabled>true</enabled>
         <param>
            <name>knox.token.exp.server-managed</name>
            <value>true</value>
         </param>
         <param>
            <!-- Authorize a requested audience on a same-subject exchange against the
                 subject token's own aud claim. Off by default (the fail-safe): the
                 requested audience is ignored so no arbitrary aud can be minted. -->
            <name>delegation.same.subject.requested.audience.enabled</name>
            <value>true</value>
         </param>
      </provider>
      <provider>
            <role>identity-assertion</role>
            <name>Default</name>
            <enabled>true</enabled>
      </provider>
    </gateway>

    <service>
        <role>KNOXIDF</role>
        <param>
           <name>knoxidf.knox.token.ttl</name>
           <value>86400000</value>
        </param>
        <param>
            <name>knoxidf.knox.token.limit.per.user</name>
            <value>-1</value>
        </param>
        <param>
            <!-- Mint the requested (and now-authorized) audience onto the exchanged token,
                 rather than a fixed configured set. Safe only because the same-subject
                 requested-audience flag above authorizes the requested value first. -->
            <name>knoxidf.knox.token.audience.validator</name>
            <value>passthrough</value>
        </param>
        <param>
            <name>knoxidf.auto.consent.enabled</name>
            <value>true</value>
        </param>
    </service>
</topology>
