<!--
  Delegation-enabled counterpart of knoxidf-token.xml. The JWTProvider turns on
  RFC 8693 delegation (delegation.server.enabled) and both requested-audience
  enforcement flags, so a delegation exchange (one carrying an actor_token or a
  differing requested_subject) must supply exactly one audience/resource value.
  A same-subject exchange is unaffected by these flags and still succeeds here.

  The delegation policy store is the gateway-wide, zero-config embedded H2
  service (KNOX-3401); no policy needs to be seeded for the exchanges this
  topology is used to test, because audience enforcement and the
  delegation-enabled gate are both evaluated before any policy lookup.
-->
<topology>
    <gateway>
      <provider>
         <role>federation</role>
         <name>JWTProvider</name>
         <enabled>true</enabled>
         <param>
            <name>knox.token.exp.server-managed</name>
            <value>true</value>
         </param>
         <param>
            <!-- Turn on RFC 8693 delegation exchange for this topology. While off (the
                 default in knoxidf-token.xml), any actor_token/requested_subject exchange
                 is rejected with "Delegation is not enabled for this topology". -->
            <name>delegation.server.enabled</name>
            <value>true</value>
         </param>
         <param>
            <!-- A delegation exchange must carry at least one audience/resource value. -->
            <name>delegation.enforce.requested.audience.required</name>
            <value>true</value>
         </param>
         <param>
            <!-- A delegation exchange must carry at most one distinct audience/resource value. -->
            <name>delegation.enforce.requested.audience.max.one</name>
            <value>true</value>
         </param>
      </provider>
      <provider>
            <role>identity-assertion</role>
            <name>Default</name>
            <enabled>true</enabled>
      </provider>
    </gateway>

    <service>
        <role>KNOXIDF</role>
        <param>
           <name>knoxidf.knox.token.ttl</name>
           <value>86400000</value>
        </param>
        <param>
            <name>knoxidf.knox.token.limit.per.user</name>
            <value>-1</value>
        </param>
        <param>
            <name>knoxidf.auto.consent.enabled</name>
            <value>true</value>
        </param>
    </service>
</topology>
