<!--
  KNOX-3478 misconfiguration path: the token header name is the actor id header
  name. The token must be dropped rather than the identity, so that a typo here
  can never overwrite the header this service exists to assert.
-->
<topology>
	<gateway>
		<provider>
			<role>federation</role>
			<name>JWTProvider</name>
			<enabled>true</enabled>
			<param>
				<name>knox.token.use.cookie</name>
				<value>false</value>
			</param>
			<param>
				<name>jwt.expected.sigalg</name>
				<value>RS256</value>
			</param>
			<param>
				<name>knox.token.exp.server-managed</name>
				<value>true</value>
			</param>
		</provider>
		<!--
		  group.principal.mapping makes CommonIdentityAssertionFilter map groups, which
		  sets groupsMapped and sends the request down the re-wrap branch of
		  AbstractIdentityAssertionFilter.continueChainAsPrincipal: a brand new Subject
		  is built and only explicitly copied state survives. That is the branch the
		  captured token has to survive, so this topology exercises it deliberately
		  rather than testing the easier no-rewrap path.
		-->
		<provider>
			<role>identity-assertion</role>
			<name>Default</name>
			<enabled>true</enabled>
			<param>
				<name>group.principal.mapping</name>
				<value>guest=forwarded-token-group</value>
			</param>
		</provider>
	</gateway>
	<service>
		<role>KNOX-AUTH-SERVICE</role>
		<param>
			<name>preauth.auth.header.actor.id.name</name>
			<value>x-knox-actor-username</value>
		</param>
		<param>
			<name>preauth.auth.header.actor.groups.prefix</name>
			<value>x-knox-actor-groups</value>
		</param>
		<param>
			<name>preauth.auth.header.auth.token.name</name>
			<value>x-knox-actor-username</value>
		</param>
	</service>
</topology>
